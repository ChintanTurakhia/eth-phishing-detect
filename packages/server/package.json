{
  "name": "@virtual-sim/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "sim:seed": "tsx src/cli/seed.ts",
    "sim:run": "tsx src/cli/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@virtual-sim/core": "workspace:*",
    "@virtual-sim/shared": "workspace:*",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.8.0",
    "chokidar": "^4.0.0",
    "fastify": "^5.2.0",
    "@fastify/cors": "^10.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^25.9.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
