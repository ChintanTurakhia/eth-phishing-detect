# ── Vercel (set these in the Vercel dashboard for the frontend project) ──────
# URL of the separately-hosted sim server (Railway / Render / Fly.io)
SERVER_URL=https://your-sim-server.railway.app
# WebSocket URL of the sim server — must be wss:// in production
NEXT_PUBLIC_SERVER_WS=wss://your-sim-server.railway.app/ws

# ── Sim server (set on the server host, not Vercel) ─────────────────────────
# Required for live simulation (cognition + importance scoring)
ANTHROPIC_API_KEY=

# Optional: use Voyage AI embeddings instead of local MiniLM
VOYAGE_API_KEY=

# Server
PORT=4000
DATABASE_PATH=./data/sim.db

# MCP servers (leave blank to use bundled mock fixtures)
MCP_LINEAR_URL=
MCP_SLACK_URL=
MCP_GITHUB_URL=
MCP_GLEAN_URL=
MCP_SNOWFLAKE_URL=
