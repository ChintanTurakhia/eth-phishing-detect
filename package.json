{
  "name": "virtual-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Generative-agents simulation of a software engineering team (Park et al. 2023), with read-only MCP grounding, a human review queue, and a dual-view UI.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter './packages/*' test",
    "db:migrate": "pnpm --filter @virtual-sim/server db:migrate",
    "sim:seed": "pnpm --filter @virtual-sim/server sim:seed",
    "sim:run": "pnpm --filter @virtual-sim/server sim:run",
    "dev:server": "pnpm --filter @virtual-sim/server dev",
    "dev:web": "pnpm --filter web dev",
    "dev": "pnpm -r --parallel --filter @virtual-sim/server --filter web dev"
  }
}
